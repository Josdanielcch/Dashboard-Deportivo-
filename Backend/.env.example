#Server
PORT=3000
NODE_ENV=development

# Database (Neon.tech)
DATABASE_URL="postgresql://..."

# JWT
JWT_SECRET="tu_clave_secreta_aqui"
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Mailer - Desarrollo (Mailtrap)
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=tu_usuario_mailtrap
# SMTP_PASS=tu_password_mailtrap
# FRONTEND_URL=http://localhost:5173

# Mailer - Brevo (Sendinblue) SMTP recomendado
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=tu_login_de_brevo (ej: bb2c0e001@smtp-brevo.com o tu correo de cuenta)
# SMTP_PASS=xsmtpsib-tu_clave_smtp_generada_en_brevo
# SMTP_FROM="CourtManager <tu_email_verificado@gmail.com>"
# FRONTEND_URL=http://localhost:5173

# Mailer - Produccion alternativo (Gmail u otro SMTP real)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tu_email@gmail.com
# SMTP_PASS=tu_app_password
# SMTP_FROM="CourtManager <tu_email@gmail.com>"
# FRONTEND_URL=https://aplicationfrontend.netlify.app

# Redis (cache) - Opcional, si no se configura usa mock en memoria
# Local: REDIS_URL="redis://127.0.0.1:6379"
# Upstash: REDIS_URL="redis://default:token@host.upstash.io:6379"
# Railway: REDISTOGO_URL se configura automaticamente
# REDIS_URL="redis://127.0.0.1:6379"
