# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL / Neon.tech)
DATABASE_URL="postgresql://usuario:password@host/neondb?sslmode=require"

# JWT Authentication
JWT_SECRET="genera_una_clave_aleatoria_segura_de_al_menos_32_caracteres"
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET="genera_otra_clave_aleatoria_segura_para_refresh_tokens"
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS
CORS_ORIGIN="http://localhost:5173,https://tudominio.com"

# Google OAuth (Opcional - Requerido para login social seguro)
GOOGLE_CLIENT_ID="tu_google_client_id.apps.googleusercontent.com"

# Mailer - Producción (Brevo / Sendinblue / Resend / Gmail)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=tu_email_de_cuenta@dominio.com
SMTP_PASS=tu_clave_smtp_generada
SMTP_FROM="CourtManager <no-reply@tudominio.com>"
FRONTEND_URL=http://localhost:5173

# Redis (Cache y Rate Limiting) - Opcional, si no se configura usa mock en memoria
# Local: REDIS_URL="redis://127.0.0.1:6379"
# Upstash: REDIS_URL="rediss://default:token@host.upstash.io:6379"
REDIS_URL="redis://127.0.0.1:6379"

# Cloud Storage (Cloudinary / CDN para producción - Opcional, si no se configura usa disco local)
# CLOUDINARY_CLOUD_NAME="tu_cloud_name"
# CLOUDINARY_API_KEY="tu_api_key"
# CLOUDINARY_API_SECRET="tu_api_secret"

# Configuración Comercial y Fiscal
DEFAULT_TAX_RATE=0.16
DEFAULT_CURRENCY=USD
APP_TIMEZONE="America/Caracas"

# Pasarela de Pagos en Línea (Stripe - Opcional, si no se configura opera en modo Sandbox)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
